# ==============================================================================
# EIA Clearance Pre-Screening Service: runtime configuration (Requirement D4)
#
# No credentials, endpoints or model identifiers live in the code. Everything
# environment-specific is read from here at runtime:
#   1. .env          your machine's values (gitignored; copy this file to start)
#   2. .env.example  documented defaults for anything .env does not set
# Docker Compose loads both, then overrides the service-to-service addresses.
#
# These defaults run the whole system with NO API key: the stub LLM answers.
# ==============================================================================

# ---------------------------------------------------------------- LLM provider
# Any OpenAI-compatible Chat Completions endpoint. The provider is changed here,
# never in code.
#   stub   : the stub LLM (in-process when LLM_BASE_URL is empty, or the
#            llm-stub container in Docker). Free, deterministic, ~1.5 s per call.
#   nvidia : NVIDIA NIM free tier. Get a key at build.nvidia.com ("Get API Key"),
#            then set, in .env:
#              LLM_PROVIDER=nvidia
#              LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#              LLM_API_KEY=nvapi-...
#              LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
#              LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_PROVIDER=stub
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=stub-model
# Second model on the degradation path, tried when the first fails or its breaker is open
LLM_FALLBACK_MODEL=
LLM_MAX_OUTPUT_TOKENS=4096
# Reasoning models (mistral-large-4, nemotron) think before answering; "low" cut a verifier
# call from 11 s to 3 s in testing. Empty = provider default. Sent as `reasoning_effort`.
LLM_REASONING_EFFORT=

# Price recorded with every call to compute cost per step / per run (L5).
# The NVIDIA free tier bills $0; these are reference list prices (USD per 1K tokens)
# for an equivalent hosted model, so cost per 100 runs is meaningful. Adjust to your provider.
LLM_PRICE_INPUT_PER_1K=0.0002
LLM_PRICE_OUTPUT_PER_1K=0.0006

# Stub LLM latency per call, seconds (D6 load tests use 1.5 to mimic a real model)
STUB_LLM_DELAY_SECONDS=0.3

# ---------------------------------------------------------------- Prompts (L2)
PROMPT_VERSION=v1

# ---------------------------------------------------------------- Agent limits (A1)
# A step is one graph node or one LLM turn. A normal run uses 8-12 steps and 3-5 tool calls.
MAX_STEPS=24
MAX_TOOL_CALLS=20
MAX_VERIFICATION_RETRIES=2
RUN_DEADLINE_SECONDS=90

# ---------------------------------------------------------------- Resilience (A5)
LLM_TIMEOUT_SECONDS=45
TOOL_TIMEOUT_SECONDS=10
MAX_RETRIES=2
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT=30

# ---------------------------------------------------------------- Retrieval (L1, D2)
# Local sentence-transformers model: embeddings cost nothing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------------------------------------------------------------- Services
# Empty REDIS_URL = local single-process mode (runs execute inside the API process).
# Docker Compose sets redis://redis:6379/0.
REDIS_URL=
# Empty = the Verifier runs in-process. Docker Compose sets http://verifier-agent:8002.
VERIFIER_URL=

# ---------------------------------------------------------------- Cost controls (D7)
CACHE_ENABLED=true
RUN_CACHE_TTL_SECONDS=86400
RATE_LIMIT_PER_MINUTE=20

# ---------------------------------------------------------------- Quality monitoring (L6)
# Share of live runs scored automatically with the reference-free eval metrics
LIVE_EVAL_SAMPLE_RATE=0.2

# ---------------------------------------------------------------- Observability (D5)
# Empty = no trace export. Docker Compose sets http://jaeger:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Used only to print a clickable Jaeger link in run traces
JAEGER_UI_URL=http://localhost:16686
