# ==============================================================================
# Environmental Clearance Pre-Screening Service Configuration (.env.example)
# Copy this file to .env and fill in your LLM_API_KEY
# ==============================================================================

# LLM Provider Configuration
# Set LLM_PROVIDER to "nvidia", "openai", or "stub" (for offline/load-test mode)
LLM_PROVIDER=nvidia
LLM_API_KEY=your_nvidia_or_openai_api_key_here
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# Agent Execution Limits (Requirement A1)
MAX_STEPS=10
MAX_TOOL_CALLS=8
MAX_VERIFICATION_RETRIES=2

# Resilience, Timeouts & Circuit Breaker (Requirement A5)
LLM_TIMEOUT_SECONDS=15.0
TOOL_TIMEOUT_SECONDS=10.0
MAX_RETRIES=3
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT=30.0

# Prompt Management (Requirement L2)
PROMPT_VERSION=v1

# Service & Network Configuration
API_HOST=0.0.0.0
API_PORT=8000
REDIS_URL=redis://localhost:6379/0

# Observability (Requirement D5)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_METRICS_PORT=8000
