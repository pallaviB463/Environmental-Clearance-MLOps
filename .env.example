# ==============================================================================
# Environmental Clearance Pre-Screening Service Configuration
# No sensitive credentials or hardcoded keys in repository (Requirement D4)
# ==============================================================================

# Agent Execution Limits (Requirement A1)
MAX_STEPS=10
MAX_TOOL_CALLS=8
MAX_VERIFICATION_RETRIES=2

# Resilience, Timeouts & Circuit Breaker (Requirement A5)
LLM_TIMEOUT_SECONDS=10.0
TOOL_TIMEOUT_SECONDS=10.0
MAX_RETRIES=3
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT=30.0

# LLM Provider Configuration
# Set LLM_PROVIDER to "stub" for load testing / local runs without cost
LLM_PROVIDER=stub
LLM_MODEL=stub-model
LLM_BASE_URL=http://localhost:8001
LLM_API_KEY=

# Prompt Management (Requirement L2)
PROMPT_VERSION=v1

# Service & Network Configuration
API_HOST=0.0.0.0
API_PORT=8000
REDIS_URL=redis://localhost:6379/0

# Observability (Requirement D5)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_METRICS_PORT=8000